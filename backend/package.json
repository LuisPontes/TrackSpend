{
  "name": "trackspend-backend",
  "version": "1.0.0",
  "description": "TrackSpend API - shared expense tracking for small groups",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
